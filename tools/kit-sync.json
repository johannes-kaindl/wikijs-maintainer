{
  "sources": {
    "obsidian-kit": {
      "ref": "0.57.0"
    },
    "code-kit": {
      "ref": "0.24.0"
    }
  },
  "targets": [
    {
      "dir": "src/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/pure",
      "modules": [
        "frontmatter"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "settings",
        "i18n",
        "timeout",
        "diff",
        "secrets"
      ]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": [
        "clock",
        "confirm",
        "folder-suggest",
        "settings_walker",
        "help-setting"
      ]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
      "from": "src/obsidian",
      "modules": [
        "secrets"
      ],
      "rewrite": [
        [
          "../pure/",
          "../kit/"
        ],
        [
          "../vendor/code-kit/pure/",
          "../kit/"
        ]
      ]
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": [
        "obsidian-mock",
        "window-timers"
      ]
    }
  ]
}
